    {
      "id": "factory-cpp-code",
      "type": "text",
      "x": 105,
      "y": 1705,
      "width": 750,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 40,
      "version": 2,
      "versionNonce": 1255040452,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461068249,
      "link": null,
      "locked": false,
      "text": "class Vehicle {\n  virtual void start() const = 0;\n  virtual void stop() const = 0;\n};\nclass Car : public Vehicle { ... }\nclass Truck : public Vehicle { ... }\nclass Bike : public Vehicle { ... }\n\nclass VehicleFactory {\n  static unique_ptr<Vehicle> create(VehicleType type) {\n    switch (type) { case Truck: return make_unique<Truck>(); ... }\n  }\n};\n\nauto v = VehicleFactory::create(VehicleType::Truck);\nv->start(); v->stop();",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "class Vehicle {\n  virtual void start() const = 0;\n  virtual void stop() const = 0;\n};\nclass Car : public Vehicle { ... }\nclass Truck : public Vehicle { ... }\nclass Bike : public Vehicle { ... }\n\nclass VehicleFactory {\n  static unique_ptr<Vehicle> create(VehicleType type) {\n    switch (type) { case Truck: return make_unique<Truck>(); ... }\n  }\n};\n\nauto v = VehicleFactory::create(VehicleType::Truck);\nv->start(); v->stop();",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ag"
    },
    {
      "id": "factory-cpp-explain-box",
      "type": "rectangle",
      "x": 920,
      "y": 1680,
      "width": 815,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 41,
      "version": 2,
      "versionNonce": 1543948412,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461068249,
      "link": null,
      "locked": false,
      "index": "ah"
    },
    {
      "id": "factory-cpp-explain",
      "type": "text",
      "x": 950,
      "y": 1705,
      "width": 755,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 2,
      "versionNonce": 1661275460,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461068249,
      "link": null,
      "locked": false,
      "text": "Vehicle is the shared interface (the promise).\nCar, Truck, and Bike are the concrete products.\nVehicleFactory owns the type switch and returns a\nunique_ptr<Vehicle>.\n\nThe client can call start() and stop() without\nknowing the concrete vehicle class.\n\nThe full, runnable C++ example is in:\nfactory_pattern.cpp",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Vehicle is the shared interface (the promise).\nCar, Truck, and Bike are the concrete products.\nVehicleFactory owns the type switch and returns a\nunique_ptr<Vehicle>.\n\nThe client can call start() and stop() without\nknowing the concrete vehicle class.\n\nThe full, runnable C++ example is in:\nfactory_pattern.cpp",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ai"
    },

    {
      "id": "factory-takeaway",
      "type": "text",
      "x": 80,
      "y": 1450,
      "width": 1600,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 37,
      "version": 2,
      "versionNonce": 1327069052,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461068249,
      "link": null,
      "locked": false,
      "text": "Remember: the factory decides which vehicle object to create; that vehicle does the real work.\nThis simple factory centralizes creation, but adding Bus later means adding a case to the factory.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Remember: the factory decides which vehicle object to create; that vehicle does the real work.\nThis simple factory centralizes creation, but adding Bus later means adding a case to the factory.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ad"
    },
    {

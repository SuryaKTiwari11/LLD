      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 50,
      "version": 61,
      "versionNonce": 516281244,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461384275,
      "link": null,
      "locked": false,
      "text": "Takeaway: Robot subclasses describe WHAT robot it is; composed strategies decide HOW it walks, talks, and flies. Inheritance is still okay for the robot identity.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Takeaway: Robot subclasses describe WHAT robot it is; composed strategies decide HOW it walks, talks, and flies. Inheritance is still okay for the robot identity.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "an"
    }

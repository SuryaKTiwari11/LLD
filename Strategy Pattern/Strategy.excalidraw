      "updated": 1791461372322,
      "link": null,
      "locked": false,
      "text": "Robot (context)\n\n- walkBehavior: WalkBehavior\n- talkBehavior: TalkBehavior\n- flyBehavior: FlyBehavior\n\n+ walk() -> delegate\n+ talk() -> delegate\n+ fly() -> delegate\n+ projection()",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "Robot (context)\n\n- walkBehavior: WalkBehavior\n- talkBehavior: TalkBehavior\n- flyBehavior: FlyBehavior\n\n+ walk() -> delegate\n+ talk() -> delegate\n+ fly() -> delegate\n+ projection()",
      "autoResize": true,

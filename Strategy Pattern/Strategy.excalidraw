    {
      "id": "inheritance-note",
      "type": "text",
      "x": 157.66445303480714,
      "y": 1413.2294253218406,
      "width": 480,
      "height": 110,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

    {
      "id": "definition",
      "type": "text",
      "x": 82,
      "y": 100,
      "width": 1760,
      "height": 130,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2,
      "version": 2,
      "versionNonce": 1874660516,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461347729,
      "link": null,
      "locked": false,
      "text": "Strategy Pattern: put each changeable behavior behind a common interface, then give an object the behavior it needs.\nLayman: a robot is like a toy with separate plug-in walk, talk, and fly modules. Swap a module; you do not rebuild the whole robot.\nComposition over inheritance: the robot HAS behavior objects. Avoid making a subclass for every ability combination.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Strategy Pattern: put each changeable behavior behind a common interface, then give an object the behavior it needs.\nLayman: a robot is like a toy with separate plug-in walk, talk, and fly modules. Swap a module; you do not rebuild the whole robot.\nComposition over inheritance: the robot HAS behavior objects. Avoid making a subclass for every ability combination.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a1"
    },
    {
      "id": "before-box",

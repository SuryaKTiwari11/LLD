      "roundness": null,
      "seed": 42,
      "version": 70,
      "versionNonce": 1782077212,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461372322,
      "link": null,
      "locked": false,
      "text": "Inheritance describes robot kind / projection.\nComposition supplies replaceable abilities.\nUse both where each fits.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "Inheritance describes robot kind / projection.\nComposition supplies replaceable abilities.\nUse both where each fits.",

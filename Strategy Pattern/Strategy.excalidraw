      "roundness": null,
      "seed": 47,
      "version": 61,
      "versionNonce": 635551012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461384275,
      "link": null,
      "locked": false,
      "text": "class FlyBehavior {\n  virtual void fly() const = 0;\n};\nclass NormalFly : public FlyBehavior { ... };\nclass NoFly : public FlyBehavior { ... };\n\nclass Robot {\n  unique_ptr<FlyBehavior> flyBehavior_;\n  void fly() const { flyBehavior_->fly(); }\n};\n\nrobot.setFlyBehavior(make_unique<NormalFly>());",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "class FlyBehavior {\n  virtual void fly() const = 0;\n};\nclass NormalFly : public FlyBehavior { ... };\nclass NoFly : public FlyBehavior { ... };\n\nclass Robot {\n  unique_ptr<FlyBehavior> flyBehavior_;\n  void fly() const { flyBehavior_->fly(); }\n};\n\nrobot.setFlyBehavior(make_unique<NormalFly>());",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ak"
    },
    {

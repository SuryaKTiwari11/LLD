    },
    {
      "id": "code-explanation",
      "type": "text",
      "x": 939.5048382695577,
      "y": 1941.2003957044944,
      "width": 770,
      "height": 295,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 49,
      "version": 61,
      "versionNonce": 1685485732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461384275,
      "link": null,
      "locked": false,
      "text": "FlyBehavior is the shared promise: every flying choice has fly().\nNormalFly and NoFly are the interchangeable strategies.\nRobot owns a FlyBehavior object and delegates fly() to it.\nsetFlyBehavior swaps that object while the robot stays the same.\n\nunique_ptr owns each behavior safely; no manual new/delete needed.\n\nFull runnable example: strategy.cpp\nCompile: g++ -std=c++17 strategy.cpp -o strategy_demo",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "FlyBehavior is the shared promise: every flying choice has fly().\nNormalFly and NoFly are the interchangeable strategies.\nRobot owns a FlyBehavior object and delegates fly() to it.\nsetFlyBehavior swaps that object while the robot stays the same.\n\nunique_ptr owns each behavior safely; no manual new/delete needed.\n\nFull runnable example: strategy.cpp\nCompile: g++ -std=c++17 strategy.cpp -o strategy_demo",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "am"
    },
    {
      "id": "final-note",
      "type": "text",
      "x": 69.5048382695577,
      "y": 2316.2003957044944,
      "width": 1680,

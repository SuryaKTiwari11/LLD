    {
      "id": "why-text",
      "type": "text",
      "x": 900,
      "y": 285,
      "width": 820,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 6,
      "version": 2,
      "versionNonce": 668283812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791461347729,
      "link": null,
      "locked": false,
      "text": "THE IDEA: BUILD WITH PLUG-IN BEHAVIORS\n\nKeep robot identity (Companion / Worker) separate\nfrom abilities (Walk / Talk / Fly).\n\nEach ability has its own interface and implementations.\nThe robot delegates each action to its current behavior.\n\nMix abilities freely; replace one at runtime.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "THE IDEA: BUILD WITH PLUG-IN BEHAVIORS\n\nKeep robot identity (Companion / Worker) separate\nfrom abilities (Walk / Talk / Fly).\n\nEach ability has its own interface and implementations.\nThe robot delegates each action to its current behavior.\n\nMix abilities freely; replace one at runtime.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"
    },

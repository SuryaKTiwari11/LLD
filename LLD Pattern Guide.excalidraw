    {
      "id": "singleton-text",
      "type": "text",
      "x": 808,
      "y": 585,
      "width": 605,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 10,
      "version": 1,
      "versionNonce": 310,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "CREATIONAL  |  SINGLETON — share one instance\nUse when: exactly one instance is a real requirement for a resource or shared state.\nLayman: an office printer shared by a team—not one printer per employee.\nIn the workspace: Application and UserService access the same Logger through Logger::instance().\nTrade-off: global access hides dependencies and can complicate tests. Thread-safe creation does not make all logger operations thread-safe.\nNot a default choice for every service.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "CREATIONAL  |  SINGLETON — share one instance\nUse when: exactly one instance is a real requirement for a resource or shared state.\nLayman: an office printer shared by a team—not one printer per employee.\nIn the workspace: Application and UserService access the same Logger through Logger::instance().\nTrade-off: global access hides dependencies and can complicate tests. Thread-safe creation does not make all logger operations thread-safe.\nNot a default choice for every service.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a9"
    },

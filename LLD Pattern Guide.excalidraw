    {
      "id": "prototype-card-text",
      "type": "text",
      "x": 808,
      "y": 904,
      "width": 605,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 16,
      "version": 1,
      "versionNonce": 316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "CREATIONAL  |  PROTOTYPE — clone a configured object\nUse when many objects start from the same prepared template and differ only in a few details.\nLayman: copy a game character template, then change its name or level.\nIn the workspace: GameCharacter.clone() copies the template; clones can be customized independently. Think about deep copying if an object owns pointers or shared resources.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "CREATIONAL  |  PROTOTYPE — clone a configured object\nUse when many objects start from the same prepared template and differ only in a few details.\nLayman: copy a game character template, then change its name or level.\nIn the workspace: GameCharacter.clone() copies the template; clones can be customized independently. Think about deep copying if an object owns pointers or shared resources.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aF"
    },

    },
    {
      "id": "abstract-factory-text",
      "type": "text",
      "x": 88,
      "y": 585,
      "width": 605,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 8,
      "version": 1,
      "versionNonce": 308,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "CREATIONAL  |  ABSTRACT FACTORY — create a matching family\nUse when: an app needs several related product types that should belong together.\nLayman: choose a Victorian furniture kit; its chair and sofa share the chosen style.\nIn the workspace: HondaFactory creates HondaCar + HondaTruck; ToyotaFactory creates ToyotaCar + ToyotaTruck. Factories implement a common interface; products implement their product interfaces.\nTrade-off: adding a product type changes every factory interface/implementation.\nNot for: a single unrelated object.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "CREATIONAL  |  ABSTRACT FACTORY — create a matching family\nUse when: an app needs several related product types that should belong together.\nLayman: choose a Victorian furniture kit; its chair and sofa share the chosen style.\nIn the workspace: HondaFactory creates HondaCar + HondaTruck; ToyotaFactory creates ToyotaCar + ToyotaTruck. Factories implement a common interface; products implement their product interfaces.\nTrade-off: adding a product type changes every factory interface/implementation.\nNot for: a single unrelated object.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a7"
    },
    {

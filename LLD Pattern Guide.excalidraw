    },
    {
      "id": "strategy-text",
      "type": "text",
      "x": 88,
      "y": 255,
      "width": 605,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4,
      "version": 1,
      "versionNonce": 304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "BEHAVIORAL  |  STRATEGY — change the behavior\nUse when: the same job needs several interchangeable ways to work, possibly switched at runtime.\nLayman: choose a route on your GPS—drive, walk, or transit—without replacing the GPS.\nIn the workspace: a robot HAS walk / talk / fly behaviors. This is composition: plug behavior objects into the robot instead of making a subclass for every combination.\nNot for: choosing which class to construct.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "BEHAVIORAL  |  STRATEGY — change the behavior\nUse when: the same job needs several interchangeable ways to work, possibly switched at runtime.\nLayman: choose a route on your GPS—drive, walk, or transit—without replacing the GPS.\nIn the workspace: a robot HAS walk / talk / fly behaviors. This is composition: plug behavior objects into the robot instead of making a subclass for every combination.\nNot for: choosing which class to construct.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a3"
    },
    {

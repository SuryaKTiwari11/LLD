    {
      "id": "builder-card-text",
      "type": "text",
      "x": 88,
      "y": 905,
      "width": 605,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 14,
      "version": 1,
      "versionNonce": 314,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "CREATIONAL  |  BUILDER — configure one complex object step by step\nUse when: a product has many optional settings, and positional constructor arguments are hard to understand.\nLayman: order a custom car by choosing an engine, color, seats, and extras; skipped choices keep sensible defaults.\nIn the workspace: Car::Builder(\"V8\").color(\"Red\").sunroof().build() creates a separate Car. This is not Abstract Factory: Builder assembles one object, not a family.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "CREATIONAL  |  BUILDER — configure one complex object step by step\nUse when: a product has many optional settings, and positional constructor arguments are hard to understand.\nLayman: order a custom car by choosing an engine, color, seats, and extras; skipped choices keep sensible defaults.\nIn the workspace: Car::Builder(\"V8\").color(\"Red\").sunroof().build() creates a separate Car. This is not Abstract Factory: Builder assembles one object, not a family.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aD"
    },

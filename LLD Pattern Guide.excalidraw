    },
    {
      "id": "simple-factory-text",
      "type": "text",
      "x": 808,
      "y": 255,
      "width": 605,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 6,
      "version": 1,
      "versionNonce": 306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "CREATIONAL  |  SIMPLE FACTORY — hide a creation choice\nUse when: a client requests one product through a common interface, and you want construction decisions in one place.\nLayman: tell the garage “I need a truck”; it hands back a vehicle you can use.\nIn the workspace: VehicleFactory chooses Car, Truck, or Bike. The client uses Vehicle.\nTrade-off: adding a vehicle means editing the factory’s choice logic. This is a common idiom, not the GoF Factory Method pattern.\nNot for: families of coordinated products.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "CREATIONAL  |  SIMPLE FACTORY — hide a creation choice\nUse when: a client requests one product through a common interface, and you want construction decisions in one place.\nLayman: tell the garage “I need a truck”; it hands back a vehicle you can use.\nIn the workspace: VehicleFactory chooses Car, Truck, or Bike. The client uses Vehicle.\nTrade-off: adding a vehicle means editing the factory’s choice logic. This is a common idiom, not the GoF Factory Method pattern.\nNot for: families of coordinated products.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"
    },
    {

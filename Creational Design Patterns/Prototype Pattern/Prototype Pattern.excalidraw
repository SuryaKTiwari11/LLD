      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "WITH PROTOTYPE\nKeep a configured template. Clone it for each new character, then change only the name or stats that differ.\n\nThe template stays unchanged; each character is its own object.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "WITH PROTOTYPE\nKeep a configured template. Clone it for each new character, then change only the name or stats that differ.\n\nThe template stays unchanged; each character is its own object.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"

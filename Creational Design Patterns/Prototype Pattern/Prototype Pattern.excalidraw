      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "Independent copies\nWarrior clone: rename only\nVeteran clone: rename, level, attack\n\nEach clone starts with the template's values. Changing one does not change the template or the other clone.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "Independent copies\nWarrior clone: rename only\nVeteran clone: rename, level, attack\n\nEach clone starts with the template's values. Changing one does not change the template or the other clone.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aG"

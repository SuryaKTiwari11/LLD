      "link": null,
      "locked": false,
      "text": "WITHOUT A FAMILY FACTORY\nClient chooses each concrete class itself.\n\nHonda car + Toyota truck can be mixed accidentally; brand checks and construction logic spread into client code.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "WITHOUT A FAMILY FACTORY\nClient chooses each concrete class itself.\n\nHonda car + Toyota truck can be mixed accidentally; brand checks and construction logic spread into client code.",
      "autoResize": true,

    {
      "id": "singleton-definition",
      "type": "text",
      "x": 72,
      "y": 100,
      "width": 1380,
      "height": 100,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2,
      "version": 1,
      "versionNonce": 102,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "Plain language: Singleton gives a class one shared instance and one way to access it.\nProblem it solves: if every part of the app creates its own Logger, each may keep separate settings or output state.\nThis C++17 example uses the Meyers Singleton (a function-local static), not double-checked locking.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Plain language: Singleton gives a class one shared instance and one way to access it.\nProblem it solves: if every part of the app creates its own Logger, each may keep separate settings or output state.\nThis C++17 example uses the Meyers Singleton (a function-local static), not double-checked locking.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a1"
    },
    {

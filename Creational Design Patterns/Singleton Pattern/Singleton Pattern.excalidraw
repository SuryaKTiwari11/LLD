      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "WITHOUT SINGLETON\nApplication creates Logger A\nUserService creates Logger B\n\nTwo objects can hold separate state.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "WITHOUT SINGLETON\nApplication creates Logger A\nUserService creates Logger B\n\nTwo objects can hold separate state.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a3"
    },

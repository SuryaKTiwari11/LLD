      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "WITH SINGLETON\nBoth clients call Logger::instance()\nThe class owns its one Logger object\n\nBoth clients use the same shared logger.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "WITH SINGLETON\nBoth clients call Logger::instance()\nThe class owns its one Logger object\n\nBoth clients use the same shared logger.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"
    },

      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "Logger  «Singleton»\n---------------------------\n- Logger()             private constructor\n+ instance(): Logger&   static access point\n+ log(message)\n---------------------------\nOwns one function-local static Logger.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "Logger  «Singleton»\n---------------------------\n- Logger()             private constructor\n+ instance(): Logger&   static access point\n+ log(message)\n---------------------------\nOwns one function-local static Logger.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aC"
    },

      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "Plain language: choose the pieces you want, then ask the builder to finish the object.\nUse Builder when an object has several options and a long positional constructor would be hard to read or maintain.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",

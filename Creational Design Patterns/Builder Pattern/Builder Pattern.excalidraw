    },
    {
      "id": "runtime-flow",
      "type": "text",
      "x": 75,
      "y": 910,
      "width": 1330,
      "height": 110,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 15,
      "version": 1,
      "versionNonce": 415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "1. Client starts a builder with required engine: Car::Builder(\"V8\").\n2. Client calls named options such as .color(\"Red\") and .sunroof(). Each returns the builder so calls can be chained.\n3. .build() validates settings and creates a Car value. The finished Car keeps its own values; it is not the mutable builder.\n4. A different configuration starts with a new builder, so omitted choices get defaults rather than carrying over from an earlier build.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "1. Client starts a builder with required engine: Car::Builder(\"V8\").\n2. Client calls named options such as .color(\"Red\") and .sunroof(). Each returns the builder so calls can be chained.\n3. .build() validates settings and creates a Car value. The finished Car keeps its own values; it is not the mutable builder.\n4. A different configuration starts with a new builder, so omitted choices get defaults rather than carrying over from an earlier build.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aE"
    },
    {
      "id": "tradeoffs",
      "type": "text",
      "x": 75,
      "y": 1050,
      "width": 1330,
      "height": 115,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 16,
      "version": 1,
      "versionNonce": 416,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791480000000,
      "link": null,
      "locked": false,
      "text": "TRADE-OFFS\nBuilder makes optional settings clearer and keeps finished Car creation controlled. It adds builder code, so a small object with a few required fields may be simpler with a constructor.\nThe nested Builder is grouped with Car, but nesting is an organization choice. It is not inheritance: Builder creates Car; it is not a kind of Car.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "TRADE-OFFS\nBuilder makes optional settings clearer and keeps finished Car creation controlled. It adds builder code, so a small object with a few required fields may be simpler with a constructor.\nThe nested Builder is grouped with Car, but nesting is an organization choice. It is not inheritance: Builder creates Car; it is not a kind of Car.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aF"
    }

      "link": null,
      "locked": false,
      "text": "Car::Builder\n+ Builder(engine)       required setting\n+ wheels(count)        optional setting\n+ seats(count)         optional setting\n+ color(name)          optional setting\n+ sunroof(enabled)     optional setting\n+ navigation(enabled)  optional setting\n+ build(): Car",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "Car::Builder\n+ Builder(engine)       required setting\n+ wheels(count)        optional setting\n+ seats(count)         optional setting\n+ color(name)          optional setting\n+ sunroof(enabled)     optional setting\n+ navigation(enabled)  optional setting\n+ build(): Car",
      "autoResize": true,

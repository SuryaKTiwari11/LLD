      "text": "STRATEGY PATTERN — PAYMENT PROCESSING",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 31,
      "containerId": null,
      "originalText": "STRATEGY PATTERN — PAYMENT PROCESSING",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a0"
    },
    {
      "id": "subtitle01",
      "type": "text",
      "x": 92,
      "y": 112,
      "width": 1480,
      "height": 75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 102,
      "version": 2,
      "versionNonce": 572832996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791455627721,
      "link": null,
      "locked": false,
      "text": "Strategy Pattern: define interchangeable ways to do one job, then choose one at runtime.\nLayman: one checkout counter; plug in a card, PayPal, or crypto tool.\nComposition over inheritance: the processor HAS a payment tool; swap the tool instead of making a special processor subclass.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Strategy Pattern: define interchangeable ways to do one job, then choose one at runtime.\nLayman: one checkout counter; plug in a card, PayPal, or crypto tool.\nComposition over inheritance: the processor HAS a payment tool; swap the tool instead of making a special processor subclass.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a1"
    },
    {

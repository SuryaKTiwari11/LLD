    {
      "id": "problem-text",
      "type": "text",
      "x": 830,
      "y": 220,
      "width": 760,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 106,
      "version": 2,
      "versionNonce": 599643108,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791455627721,
      "link": null,
      "locked": false,
      "text": "WHY THIS HURTS\n\n• New method? Edit the processor again.\n• Selection code grows with every provider.\n• Provider details are mixed with checkout flow.\n• One change can accidentally break another path.\n\nThe key issue is tight coupling: the processor must\nknow every payment implementation.",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "WHY THIS HURTS\n\n• New method? Edit the processor again.\n• Selection code grows with every provider.\n• Provider details are mixed with checkout flow.\n• One change can accidentally break another path.\n\nThe key issue is tight coupling: the processor must\nknow every payment implementation.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"
    },
    {
      "id": "bridge-note",
      "type": "text",
      "x": 90,
      "y": 625,
      "width": 1520,
      "height": 44,

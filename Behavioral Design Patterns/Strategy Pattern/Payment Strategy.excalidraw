      "versionNonce": 1587858524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791455627721,
      "link": null,
      "locked": false,
      "text": "Important: an interface alone is not the full fix if PaymentProcessor still has the if/else that picks a concrete class.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Important: an interface alone is not the full fix if PaymentProcessor still has the if/else that picks a concrete class.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a6"
    },
